# ==============================================================================
# .gitignore - Sistema Socioenativo 3D Multi-Alvo (OpenPTrack Windows)
# ==============================================================================

# --- Ambientes Virtuais ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Caches e Bytecode Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# --- Modelos de Redes Neurais e Pesos Binários ---
# O GitHub rejeita arquivos > 100 MB e pesos não devem ser versionados diretamente.
*.pt
*.pth
*.onnx
*.bin
*.engine
*.weights
weights/*
!weights/README.md
!weights/.gitkeep

# --- Datasets e Gravações Científicas Locais ---
recordings/*
!recordings/.gitkeep

# --- Saídas de Testes e Amostras de Imagem ---
pipeline_output.jpg
sample_kinect_color.jpg
sample_kinect_depth.jpg
tests/*.jpg
tests/*.png
*.avi
*.mp4

# --- Arquivos de IDEs e Editores ---
.vscode/
.idea/
*.swp
*.swo
.vs/
*.sublime-project
*.sublime-workspace

# --- Arquivos do Sistema Operacional ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Logs e Arquivos Temporários ---
*.log
*.tmp
*.bak
